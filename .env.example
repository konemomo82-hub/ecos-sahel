# Supabase — exposées au navigateur (préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SMTP — formulaire de contact. Serveur uniquement : PAS de préfixe NEXT_PUBLIC_,
# sinon le mot de passe se retrouverait dans le bundle envoyé au navigateur.
# Valeurs Hostinger pour une boîte du domaine :
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@ecos-sahel.org
SMTP_PASSWORD=
# Destinataire des messages. Si vide, les messages partent vers SMTP_USER.
CONTACT_TO=contact@ecos-sahel.org
